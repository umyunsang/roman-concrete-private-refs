<article>  <div class="3xl:container mx-auto px-16 lg:px-24 xl:px-32 pt-48 lg:pt-64 pb-48 lg:pb-80" data-testid="page-container">    <div class="flex flex-col lg:flex-row flex-stretch">
                    
    
